# Gmail account used to authenticate and send mail (must have an App Password —
# Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Address the booking form (QuoteForm) sends from and where booking requests land.
# If booking@yourdomain.com is a Gmail "Send As" alias of GMAIL_USER, use it here.
MAIL_FROM_BOOKING=booking@italylimoservice.com
MAIL_TO_BOOKING=booking@italylimoservice.com

# Supabase project (Project Settings → API in the Supabase dashboard).
# NEXT_PUBLIC_* values are sent to the browser — only put the anon/publishable
# key there, never the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. Bypasses Row Level Security — used exclusively in server-side
# admin operations (e.g. creating admin users). NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret required by /api/cron/overdue-invoices and /api/cron/upcoming-trips
# (sent as `Authorization: Bearer <value>`). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the same value into your scheduler (Vercel Cron, etc.) that calls those routes daily.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
